import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++)
            arr[i] = sc.nextInt();

       Arrays.sort(arr);
        int i  = arr.length-2;
       while( i>=0 && arr[i]==arr[n-1]){
        i--;
       }

       if(i>=0)
        System.out.println("Second largest ="+ arr[i] );

       else 
       System.out.println("not");
    }
}
